{
  "manifest_version": 3,
  "name": "LyricsDock",
  "version": "0.1.1",
  "description": "Sends the song playing on YouTube or YouTube Music to the LyricsDock desktop overlay.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "LyricsDock",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:47811 http://127.0.0.1:47812 http://127.0.0.1:47813"
  }
}
